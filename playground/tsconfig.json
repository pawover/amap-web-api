{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "amap-web-types"],
    "paths": {
      "amap-web-react": ["../packages/react/src/index.ts"],
      "amap-web-react/*": ["../packages/react/src/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
